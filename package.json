{
  "name": "redis-learn",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "prepare-content": "node scripts/prepare-content.mjs",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright test",
    "test:docs": "node --test tests/diagram-audit.test.mjs && node scripts/audit-diagrams.mjs",
    "predev": "node scripts/prepare-content.mjs",
    "dev": "next dev",
    "prebuild": "npm run test:docs && node scripts/prepare-content.mjs",
    "build": "next build",
    "preview": "wrangler pages dev dist",
    "deploy": "npm run build && npx wrangler pages deploy dist"
  },
  "dependencies": {
    "@vanhiep99w/docs-kit": "^0.12.0",
    "fumadocs-core": "16.17.5",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "16.17.5",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-github-admonitions-to-directives": "^2.1.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "remark-parse": "^11.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "unified": "^11.0.5"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "engines": {
    "node": ">=22"
  }
}
